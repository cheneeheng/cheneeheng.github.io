---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { projects } from '../data/projects';

const active = projects.filter((p) => p.status === 'active');
const past = projects.filter((p) => p.status === 'past');
---

<Layout title="Projects — EE Heng Chen">
  <PageHeader title="Projects" subtitle="What I'm building and what I've built." volume="04" />

  <section>
    <span class="eyebrow">Active · {active.length}</span>
    <p class="mt-1 mb-4 text-sm text-muted">What I am working on right now.</p>
    <ProjectGrid projects={active} />
  </section>

  {past.length > 0 && (
    <section class="mt-12">
      <span class="eyebrow">Past · {past.length}</span>
      <p class="mt-1 mb-4 text-sm text-muted">Research and work that is finished.</p>
      <ProjectGrid projects={past} />
    </section>
  )}
</Layout>
