---
interface Props {
  title: string;
  href: string;
  index?: string;
  eyebrow?: string;
}
const { title, href, index, eyebrow } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="mt-14 scroll-mt-20">
  <div class="flex items-end justify-between gap-4 border-b border-line pb-3">
    <div class="flex items-baseline gap-3">
      {index && <span class="eyebrow">{index}</span>}
      <div>
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h2 class="mt-1 font-serif text-2xl font-semibold tracking-tight text-ink">{title}</h2>
      </div>
    </div>
    <a
      href={base + href}
      class="group inline-flex items-center gap-1 text-sm font-medium no-underline hover:underline"
    >
      View all
      <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
    </a>
  </div>
  <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-4">
    <slot />
  </div>
</section>
