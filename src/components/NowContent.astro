---
// `now.md` is imported via Astro's built-in Markdown support.
import { Content as Now, frontmatter } from '../content/now.md';
import { formatDate } from '../lib/date';
---

<section>
  {frontmatter?.updated && (
    <p class="eyebrow mb-6">Last updated · {formatDate(frontmatter.updated)}</p>
  )}
  <div class="prose max-w-none leading-relaxed">
    <Now />
  </div>
</section>
