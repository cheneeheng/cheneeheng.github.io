---
const groups: { heading: string; tags: string[] }[] = [
  {
    heading: 'Research areas',
    tags: [
      'Optical flow',
      'Object detection',
      'Segmentation',
      'Action recognition',
      'Pose estimation',
      'Autonomous vehicles',
      'LLM agents',
    ],
  },
  {
    heading: 'Languages',
    tags: ['Python', 'C++'],
  },
  {
    heading: 'Tools',
    tags: ['OpenCV', 'PyTorch', 'TensorFlow', 'Kubernetes', 'Docker', 'Realsense / Kinect'],
  },
];
---

<section class="mt-12 space-y-6">
  {groups.map((g) => (
    <div>
      <span class="eyebrow">{g.heading} · {g.tags.length}</span>
      <ul class="mt-2 flex flex-wrap gap-1.5">
        {g.tags.map((t) => (
          <li class="badge">{t}</li>
        ))}
      </ul>
    </div>
  ))}
</section>
