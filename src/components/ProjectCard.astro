---
import type { Project } from '../data/projects';
interface Props {
  project: Project;
}
const { project } = Astro.props;

// Stable colour per project, so an entity keeps its tile wherever it appears.
const hash = [...project.title].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
const data = `var(--data-${(hash % 6) + 1})`;
const tile = `color:${data};background:color-mix(in srgb, ${data} 12%, transparent);border-color:color-mix(in srgb, ${data} 35%, transparent)`;
---

<article class="group relative flex flex-col rounded-lg border border-line bg-surface p-5 transition-colors hover:border-line-strong">
  <div class="flex items-start gap-3">
    <span
      class="mono flex h-8 w-8 shrink-0 items-center justify-center rounded-md border text-sm font-semibold"
      style={tile}
      aria-hidden="true"
    >
      {project.title[0]}
    </span>
    <h3 class="min-w-0 font-serif text-lg font-semibold tracking-tight text-ink">
      {project.link ? (
        <a href={project.link} class="stretched-link text-ink no-underline hover:text-brand">{project.title}</a>
      ) : (
        project.title
      )}
    </h3>
  </div>

  <p class="mt-3 grow text-muted leading-relaxed">{project.summary}</p>

  <ul class="mt-4 flex flex-wrap items-center gap-1.5">
    <li class={project.status === 'active' ? 'badge badge-secondary' : 'badge'}>{project.status}</li>
    <li aria-hidden="true" class="text-subtle">·</li>
    {project.tags.map((t) => (
      <li class="badge">{t}</li>
    ))}
  </ul>

  {project.link && (
    <span
      aria-hidden="true"
      class="pointer-events-none absolute right-4 top-4 text-brand opacity-0 transition-all duration-200 group-hover:opacity-100 group-focus-within:opacity-100 group-hover:translate-x-0.5"
    >&rarr;</span>
  )}
</article>
