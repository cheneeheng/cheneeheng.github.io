---
import type { Publication } from '../data/publications';
import PublicationCard from './PublicationCard.astro';

interface Props {
  publications: Publication[];
}
const { publications } = Astro.props;
---

<section class="space-y-4">
  {publications.length === 0 ? (
    <p class="rounded-lg border border-dashed border-line-strong p-6 text-center text-muted">
      No publications listed yet.
    </p>
  ) : (
    publications.map((p) => <PublicationCard publication={p} />)
  )}
</section>
