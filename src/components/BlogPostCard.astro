---
import { formatDate } from '../lib/date';

interface Props {
  title: string;
  date?: string;
  description?: string;
  url: string;
}
const { title, date, description, url } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<article class="group relative flex flex-col rounded-lg border border-line bg-surface p-5 transition-colors hover:border-line-strong">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h3 class="font-serif text-lg font-semibold tracking-tight text-ink">
      <a href={base + url} class="stretched-link text-ink no-underline hover:text-brand">{title}</a>
    </h3>
    {date && <span class="eyebrow shrink-0">{formatDate(date)}</span>}
  </div>
  {description && <p class="mt-3 grow text-muted leading-relaxed">{description}</p>}
</article>
