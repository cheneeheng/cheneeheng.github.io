---
interface Props {
  title: string;
  subtitle?: string;
  volume?: string;
}
const { title, subtitle, volume } = Astro.props;
---

<header class="-mt-6 mb-10 pt-10 pb-8 border-b border-line">
  {volume && <span class="eyebrow">Vol · {volume}</span>}
  <h1 class:list={['font-serif text-4xl sm:text-5xl font-semibold tracking-[-0.02em] leading-[1.05] text-ink', volume && 'mt-3']}>
    {title}
  </h1>
  {subtitle && <p class="mt-3 text-muted max-w-2xl leading-relaxed">{subtitle}</p>}
</header>
