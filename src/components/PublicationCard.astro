---
import type { Publication } from '../data/publications';
interface Props {
  publication: Publication;
}
const { publication } = Astro.props;
---

<article class="rounded-lg border border-line bg-surface p-5 transition-colors hover:border-line-strong">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h3 class="font-serif text-lg font-semibold tracking-tight text-ink">{publication.title}</h3>
    <span class="eyebrow shrink-0">{publication.year}</span>
  </div>
  <div class="mt-1 text-sm text-muted">{publication.venue}</div>
  <p class="mt-3 text-sm text-subtle">{publication.authors}</p>
  <div class="mt-4 flex flex-wrap items-center gap-3">
    {publication.pdf_url && (
      <a href={publication.pdf_url} class="text-sm font-medium">Paper &rarr;</a>
    )}
    {publication.status && <span class="badge badge-accent">{publication.status}</span>}
  </div>
</article>
